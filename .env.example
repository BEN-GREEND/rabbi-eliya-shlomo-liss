# ============================================================================
#  משתני סביבה — שמות בלבד.
#  אין להכניס לקובץ הזה שום ערך אמיתי. הוא נמצא ב-git.
#  את הערכים האמיתיים יש להזין ב-.env.local (חסום ב-.gitignore)
#  ובלוח הבקרה של Vercel.
# ============================================================================

# --- נר הזכרון ומונה המבקרים --------------------------------------------------------------
# ללא הערכים האלה האתר עובד במלואו במצב mock — הדלקת נר, צינון ומונה מבקרים.
# אותו פרויקט Supabase משמש את שתי הטבלאות: memorial_candles ו-site_visitors.
#
# שים לב: אין כאן מפתח anon ואין NEXT_PUBLIC_ כלשהו. RLS חוסם את מפתח ה-anon
# לחלוטין, וכל הגישה לטבלה עוברת דרך ה-route handler בצד השרת בלבד — ולכן שום
# מפתח אינו מגיע לדפדפן.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# מחרוזת אקראית ארוכה. משמשת ל-hash של אסימון המבקר האנונימי — גם לנר
# הזכרון וגם למונה המבקרים. ה-hash מופרד לפי תחום (candle / visitor), ולכן
# אותו דפדפן מייצר שני ערכים שונים ואי אפשר לחבר בין שתי הטבלאות.
# יש לייצר מחרוזת אחת ולא לשנותה — שינוי מאפס צינון וספירת מבקרים.
ANON_TOKEN_PEPPER=

# חלון הצינון בין שתי הדלקות מאותו דפדפן. ברירת מחדל: 24.
CANDLE_COOLDOWN_HOURS=24

# --- כללי -------------------------------------------------------------------
# כתובת האתר בפרודקשן. נקראת גם מ-content/site.yml.
NEXT_PUBLIC_SITE_URL=
