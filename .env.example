# ============================================================================
#  משתני סביבה — שמות בלבד.
#  אין להכניס לקובץ הזה שום ערך אמיתי. הוא נמצא ב-git.
#  את הערכים האמיתיים יש להזין ב-.env.local (חסום ב-.gitignore)
#  ובלוח הבקרה של Vercel.
# ============================================================================

# --- נר הזכרון (שלב 5) ------------------------------------------------------
# ללא הערכים האלה האתר עובד במלואו במצב mock, כולל הדלקת נר.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only. לעולם לא בקידומת NEXT_PUBLIC_ — היא הייתה חושפת אותו לדפדפן.
SUPABASE_SERVICE_ROLE_KEY=

# מחרוזת אקראית ארוכה. משמשת ל-hash של אסימון המבקר, כדי שמסד הנתונים
# לא יחזיק שום מזהה הפיך.
CANDLE_TOKEN_PEPPER=

# חלון הצינון בין שתי הדלקות מאותו דפדפן.
CANDLE_COOLDOWN_HOURS=24

# --- כללי -------------------------------------------------------------------
# כתובת האתר בפרודקשן. נקראת גם מ-content/site.yml.
NEXT_PUBLIC_SITE_URL=
